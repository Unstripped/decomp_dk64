#!/bin/sh
# Run a command in the dk64-decomp toolchain container, e.g. `tools/dk make setup`.
# Thin wrapper over the dkd client (tools/dkd/client.py); see tools/dkd/ for the design.
self=$0
while [ -h "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
exec python3 "$(dirname "$self")/dkd/client.py" "$@"
